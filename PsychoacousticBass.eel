desc: Psychoacoustic Bass (Missing Fundamental)

bassFreq:100<40,250,1>Bass band cutoff (Hz)
harmonicDrive:3<0.2,10,0.1>Harmonic drive
evenMix:0.6<0,1,0.01>Even/odd balance
harmonicsMix:1.0<0,2,0.01>Harmonics mix
cutFundamental:1<0,1,1{Off,On}>Remove original bass band
cutOrder:1<0,1,1{12 dB/oct,24 dB/oct}>Fundamental cut slope

@init
bassFreq = 45;
harmonicDrive = 3.25;
evenMix = 0.31;
harmonicsMix = 1.16;
cutFundamental = 1;
cutOrder = 1;
cutQ = 0.707;

// Memory layout per filter instance: 7 slots [b0,b1,b2,a1,a2,x1,x2,y1,y2] -> use 9 slots
// slot offsets: 0=b0 1=b1 2=b2 3=a1 4=a2 5=x1 6=x2 7=y1 8=y2
LP_L = 0;
LP_R = 9;
HP1_L = 18;
HP1_R = 27;
HP2_L = 36;
HP2_R = 45;

function LP_set(base frequency qFactor)(
    x = (frequency * 2.f * $PI) / srate;
    sinX = sin(x);
    y = sinX / (qFactor * 2.f);
    cosX = cos(x);
    z = (1.f - cosX) / 2.f;
    _a0 = y + 1.f;
    _a1 = cosX * -2.f;
    _a2 = 1.f - y;
    _b0 = z;
    _b1 = 1.f - cosX;
    _b2 = z;
    base[0] = _b0 / _a0;
    base[1] = _b1 / _a0;
    base[2] = _b2 / _a0;
    base[3] = -_a1 / _a0;
    base[4] = -_a2 / _a0;
    base[5] = 0; base[6] = 0;
    base[7] = 0; base[8] = 0;
);

function LP_process(base sample)(
    out = sample * base[0] + base[5] * base[1] + base[6] * base[2] + base[7] * base[3] + base[8] * base[4];
    base[8] = base[7]; base[7] = out;
    base[6] = base[5]; base[5] = sample;
    out;
);

function HP_set(base frequency qFactor)(
    w = (frequency * 2.f * $PI) / srate;
    cosw = cos(w);
    sinw = sin(w);
    alpha = sinw / (qFactor * 2.f);
    _b0 = (1.f + cosw) / 2.f;
    _b1 = -(1.f + cosw);
    _b2 = (1.f + cosw) / 2.f;
    _a0 = 1.f + alpha;
    _a1 = -2.f * cosw;
    _a2 = 1.f - alpha;
    base[0] = _b0 / _a0;
    base[1] = _b1 / _a0;
    base[2] = _b2 / _a0;
    base[3] = -_a1 / _a0;
    base[4] = -_a2 / _a0;
    base[5] = 0; base[6] = 0;
    base[7] = 0; base[8] = 0;
);

function HP_process(base sample)(
    out = sample * base[0] + base[5] * base[1] + base[6] * base[2] + base[7] * base[3] + base[8] * base[4];
    base[8] = base[7]; base[7] = out;
    base[6] = base[5]; base[5] = sample;
    out;
);

LP_set(LP_L, bassFreq, 0.707);
LP_set(LP_R, bassFreq, 0.707);
HP_set(HP1_L, bassFreq, cutQ);
HP_set(HP1_R, bassFreq, cutQ);
HP_set(HP2_L, bassFreq, cutQ);
HP_set(HP2_R, bassFreq, cutQ);
dcL = 0; dcR = 0;

@sample
bassL = LP_process(LP_L, spl0);
bassR = LP_process(LP_R, spl1);

dL = bassL * harmonicDrive;
dR = bassR * harmonicDrive;
dL = dL / (1 + abs(dL));
dR = dR / (1 + abs(dR));

evenL = dL * dL;
evenR = dR * dR;
oddL = dL * dL * dL;
oddR = dR * dR * dR;

harmL = evenMix * evenL + (1 - evenMix) * oddL;
harmR = evenMix * evenR + (1 - evenMix) * oddR;

dcL = 0.9995 * dcL + 0.0005 * harmL;
dcR = 0.9995 * dcR + 0.0005 * harmR;
harmL -= dcL;
harmR -= dcR;

cutFundamental > 0.5 ? (
  dryL = HP_process(HP1_L, spl0);
  dryR = HP_process(HP1_R, spl1);
  cutOrder > 0.5 ? (
    dryL = HP_process(HP2_L, dryL);
    dryR = HP_process(HP2_R, dryR);
  );
) : (
  dryL = spl0;
  dryR = spl1;
);

spl0 = dryL + harmL * harmonicsMix;
spl1 = dryR + harmR * harmonicsMix;
