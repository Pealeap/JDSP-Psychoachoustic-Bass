desc: Psychoacoustic Bass (Missing Fundamental)

bassFreq:45<40,250,1>Bass band cutoff (Hz)
harmonicDrive:2<0.2,10,0.1>Harmonic drive
evenMix:0.31<0,1,0.01>Even/odd balance
harmonicsMix:1.0<0,2,0.01>Harmonics mix
harmTop:300<120,1000,10>Harmonics upper limit (Hz)
cutFundamental:1<0,1,1{Off,On}>Remove original bass band
cutOrder:1<0,1,1{12 dB/oct,24 dB/oct}>Fundamental cut slope

@init
bassFreq = 45;
harmonicDrive = 2;
evenMix = 0.31;
harmonicsMix = 1;
harmTop = 300;
cutFundamental = 1;
cutOrder = 1;

// constants calibrated by offline simulation
qBW = 0.70710678;
subFreq = 25;
busRatio = 1.6;
envK = 1.094;
envEps = 0.03;
trimE = 1.093;
hGain = 1.65;
evenDriveMax = 1.5;

function LP_set(frequency qFactor)(
    x = (frequency * 2 * $PI) / srate;
    sinX = sin(x);
    y = sinX / (qFactor * 2);
    cosX = cos(x);
    z = (1 - cosX) / 2;
    _a0 = y + 1;
    _a1 = cosX * -2;
    _a2 = 1 - y;
    _b0 = z;
    _b1 = 1 - cosX;
    _b2 = z;
    this.y_2 = 0; this.y_1 = 0; this.x_2 = 0; this.x_1 = 0;
    this.b0 = _b0 / _a0;
    this.b1 = _b1 / _a0;
    this.b2 = _b2 / _a0;
    this.a1 = -_a1 / _a0;
    this.a2 = -_a2 / _a0;
);

function LP_process(sample)(
    out = sample * this.b0 + this.x_1 * this.b1 + this.x_2 * this.b2 + this.y_1 * this.a1 + this.y_2 * this.a2;
    this.y_2 = this.y_1; this.y_1 = out;
    this.x_2 = this.x_1; this.x_1 = sample;
    out;
);

function HP_set(frequency qFactor)(
    w = (frequency * 2 * $PI) / srate;
    cosw = cos(w);
    sinw = sin(w);
    alpha = sinw / (qFactor * 2);
    _b0 = (1 + cosw) / 2;
    _b1 = -(1 + cosw);
    _b2 = (1 + cosw) / 2;
    _a0 = 1 + alpha;
    _a1 = -2 * cosw;
    _a2 = 1 - alpha;
    this.y_2 = 0; this.y_1 = 0; this.x_2 = 0; this.x_1 = 0;
    this.b0 = _b0 / _a0;
    this.b1 = _b1 / _a0;
    this.b2 = _b2 / _a0;
    this.a1 = -_a1 / _a0;
    this.a2 = -_a2 / _a0;
);

function HP_process(sample)(
    out = sample * this.b0 + this.x_1 * this.b1 + this.x_2 * this.b2 + this.y_1 * this.a1 + this.y_2 * this.a2;
    this.y_2 = this.y_1; this.y_1 = out;
    this.x_2 = this.x_1; this.x_1 = sample;
    out;
);

// harmonic generator chain, mono
nSub.HP_set(subFreq, qBW);
nBand.LP_set(bassFreq, qBW);
busFreq = bassFreq * busRatio;
nBusHp1.HP_set(busFreq, qBW);
nBusHp2.HP_set(busFreq, qBW);
nBusLp.LP_set(harmTop, qBW);

// drypath fundamental cut stereo
hp1_l.HP_set(bassFreq, qBW);
hp1_r.HP_set(bassFreq, qBW);
hp2_l.HP_set(bassFreq, qBW);
hp2_r.HP_set(bassFreq, qBW);

// fast attack, slow release
env = 0;
envAtk = exp(-1 / (0.005 * srate));
envRel = exp(-1 / (0.1 * srate));

@sample
inL = spl0;
inR = spl1;

// 1 mono bass band, same harmonics for both ears = no localization cue
bm = nSub.HP_process((inL + inR) * 0.5);
bm = nBand.LP_process(bm);

// 2 level tracking, harmonics follow the bass level instead of exploding with it
ab = abs(bm);
ec = envRel + (envAtk - envRel) * (ab > env);
env = ab + ec * (env - ab);
gl = env * envK;
xn = bm / (gl + envEps);

// 3 odd path cubic soft clip, even path, rectified soft clip -drive capped
so = max(-1, min(1, xn * harmonicDrive));
so = 1.5 * (so - so * so * so / 3);
se = max(-1, min(1, xn * min(harmonicDrive, evenDriveMax)));
se = abs(1.5 * (se - se * se * se / 3));

// 4 mix re-apply level strip the fundamental and the dc and limit the top end
hm = (evenMix * trimE * se + (1 - evenMix) * so) * gl;
hm = nBusHp1.HP_process(hm);
hm = nBusHp2.HP_process(hm);
hm = nBusLp.LP_process(hm);
hm = hm * harmonicsMix * hGain;

// 5 optional fundamental cut on the dry signal
cutFundamental > 0.5 ? (
  dryL = hp1_l.HP_process(inL);
  dryR = hp1_r.HP_process(inR);
  cutOrder > 0.5 ? (
    dryL = hp2_l.HP_process(dryL);
    dryR = hp2_r.HP_process(dryR);
  );
) : (
  dryL = inL;
  dryR = inR;
);

spl0 = dryL + hm;
spl1 = dryR + hm;
